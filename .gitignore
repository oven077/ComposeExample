**/lint/generated/
**/lint/outputs/
**/lint/tmp/

# NDK / CMake
.externalNativeBuild/
.cxx/

# Screenshots профилировщика
captures/

# Kotlin (кэши компилятора)
.kotlin/

# Загрузки приложения через Android Studio
app/release/

# Бэкапы
*.bak
*.swp

# Heap dumps JVM / Android Profiler
*.hprof

# Keystore и файлы подписи (не должны попадать в репозиторий)
*.jks
*.keystore

# Эмулятор snapshots
.snapshots/

# macOS
.DS_Store

