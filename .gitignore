# Gradle
.gradle/
**/build/

# Local SDK path и прочая машинно‑локальная конфигурация
local.properties

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.iws

# Выход сборки Android
*.apk
*.aar
*.ap_
*.aab
*.dex

# Отчёты Lint (генерируемые каталоги)
